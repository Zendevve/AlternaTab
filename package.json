{
  "name": "alternatab-nextgen",
  "version": "1.0.0",
  "description": "Ultra-fast, keyboard-first tab switching, search, organization, and tab lifecycle management",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "compile": "wxt build",
    "typecheck": "tsc --noEmit",
    "lint": "node ./node_modules/@biomejs/biome/bin/biome check .",
    "lint:fix": "node ./node_modules/@biomejs/biome/bin/biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "@webext-core/messaging": "^4.0.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.7",
    "@types/node": "^26.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
