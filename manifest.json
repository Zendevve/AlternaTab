{
  "manifest_version": 3,
  "name": "AlternaTab",
  "description": "Alt+Tab-like overlay for Chrome tabs (Alt+Q). Preview, navigate, and switch fast.",
  "version": "0.4.1",
  "version_name": "0.4.1-dev",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Toggle AlternaTab overlay"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
