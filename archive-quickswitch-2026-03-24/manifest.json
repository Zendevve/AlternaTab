{
  "manifest_version": 3,
  "name": "QuickSwitch",
  "version": "0.1.0",
  "description": "The fastest tab switcher. Alt+Q.",
  "permissions": [
    "tabs",
    "activeTab",
    "sessions",
    "tabGroups",
    "storage",
    "favicon"
  ],
  "commands": {
    "toggle-switcher": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "Toggle QuickSwitch"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content-script.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "switcher/switcher.html",
        "switcher/switcher.css",
        "switcher/switcher.js",
        "lib/fuzzy.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
